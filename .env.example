# Optional credentials. Copy to .env and fill in what you have.
# Sources whose key is absent are reported as "skipped", never as failures.

# OSINT_API_KEYS__SHODAN=
# OSINT_API_KEYS__HIBP=
# OSINT_API_KEYS__URLSCAN=
# OSINT_API_KEYS__VIRUSTOTAL=
# OSINT_API_KEYS__GITHUB=

# Probe Bot chat (OpenAI-compatible; DeepSeek defaults below).
# Without a key the bot runs in offline FAQ mode and sends nothing anywhere.
# OSINT_PROBE_BOT_API_KEY=
# OSINT_PROBE_BOT_BASE_URL=https://api.deepseek.com
# OSINT_PROBE_BOT_MODEL=deepseek-chat

# Non-secret overrides (same names as config.yaml, env wins):
# OSINT_DEADLINE_S=10
# OSINT_CONCURRENCY=12
# OSINT_LOG_LEVEL=DEBUG
# OSINT_PERSONAL_MAX_SOURCES=45
